<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.scenes.MainSenceController">
   <left>
      <VBox id="editingSideBar" maxHeight="Infinity" prefHeight="400.0" prefWidth="166.0" BorderPane.alignment="TOP_LEFT">
         <children>
            <Button fx:id="addTrafficNodeButton" alignment="CENTER" mnemonicParsing="false" onAction="#addNewNode" text="Add Traffic Node" />
            <Button fx:id="removeTrafficNodeButton" mnemonicParsing="false" onAction="#removeNode" text="Remove Traffic Node" />
            <Button fx:id="addRoadButton" mnemonicParsing="false" onAction="#addNewRoad" text="Add Road" />
            <Label fx:id="instructionsLabel" text="Label" />
         </children>
      </VBox>
   </left>
   <center>
      <ScrollPane fx:id="trafficMapContainer" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
